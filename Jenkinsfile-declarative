pipeline {
    agent any

    environment {
        APP_NAME = 'maven-web-app'
        APP_VERSION = '1.0'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo "Application: ${APP_NAME}"
                echo "Version: ${APP_VERSION}"
                sh 'mvn clean package'
            }
        }

        stage('Environment') {
            steps {
                echo "Selected environment: ${params.ENVIRONMENT}"
            }
        }

        stage('Deploy') {
            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }

            steps {
                echo "Deploying ${APP_NAME} version ${APP_VERSION} to ${params.ENVIRONMENT}"
            }
        }
    }
}
